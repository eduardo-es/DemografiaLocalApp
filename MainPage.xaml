<?xml version="1.0" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="DemografiaLocalApp.MainPage" Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light=#F4F6FA, Dark=#10151E}">
    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1B2432}"/>
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#DDE3EC, Dark=#344054}"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Muted" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#526174, Dark=#BBC7D8}"/>
        </Style>
        <Style x:Key="Choice" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EDF1F7, Dark=#29364A}"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#182C48, Dark=White}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinimumHeightRequest" Value="52"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
        </Style>
        <DataTemplate x:Key="NameRow">
            <Grid ColumnDefinitions="*,Auto" Padding="0,11" ColumnSpacing="12">
                <Label Text="{Binding NomeExibicao}" FontSize="16" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding Frequencia, StringFormat='{0:N0}'}" FontSize="15" TextColor="{AppThemeBinding Light=#526174, Dark=#BBC7D8}" VerticalOptions="Center"/>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>
    <ScrollView VerticalScrollBarVisibility="Always">
        <VerticalStackLayout Padding="20,24" Spacing="18">
            <VerticalStackLayout Spacing="5">
                <Label Text="IBGE / CENSO 2022" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#512BD4, Dark=#B9A7FF}"/>
                <Label Text="Nomes pelo Brasil" FontSize="28" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1"/>
                <Label Text="Explore os nomes e sobrenomes de cada região." Style="{StaticResource Muted}"/>
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. Escolha a localidade" FontSize="17" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Estado" Style="{StaticResource Choice}" Command="{Binding SelecionarModoEstadoCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ModoEstado}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#512BD4"/>
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="Município" Style="{StaticResource Choice}" Command="{Binding SelecionarModoMunicipioCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ModoMunicipio}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#512BD4"/>
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Label Text="Estado" Style="{StaticResource Muted}"/>
                    <Button Text="{Binding TextoEstado}" Style="{StaticResource Choice}" Clicked="OnEscolherEstado" IsEnabled="{Binding PodeSelecionarEstado}" SemanticProperties.Hint="Abre a lista com busca dos 27 estados"/>
                    <ActivityIndicator IsVisible="{Binding EstaCarregandoEstados}" IsRunning="{Binding EstaCarregandoEstados}" Color="#512BD4"/>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ModoMunicipio}">
                        <Label Text="Município" Style="{StaticResource Muted}"/>
                        <Button Text="{Binding TextoMunicipio}" Style="{StaticResource Choice}" Clicked="OnEscolherMunicipio" IsEnabled="{Binding PodeSelecionarMunicipio}"/>
                        <Label Text="{Binding DicaMunicipio}" Style="{StaticResource Muted}"/>
                        <ActivityIndicator IsVisible="{Binding EstaCarregandoMunicipios}" IsRunning="{Binding EstaCarregandoMunicipios}" Color="#512BD4"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" IsVisible="{Binding TemErro}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Não foi possível concluir a consulta" FontAttributes="Bold"/>
                    <Label Text="{Binding MensagemErro}" Style="{StaticResource Muted}"/>
                    <Button Text="Tentar novamente" Command="{Binding TentarNovamenteCommand}"/>
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout IsVisible="{Binding EstaCarregandoNomes}" Spacing="8">
                <ActivityIndicator IsRunning="{Binding EstaCarregandoNomes}" Color="#512BD4"/>
                <Label Text="Buscando nomes desta localidade…" Style="{StaticResource Muted}" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}" IsVisible="{Binding MostrarDicaInicial}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Sua consulta começa aqui" FontSize="17" FontAttributes="Bold"/>
                    <Label Text="{Binding TextoDicaInicial}" Style="{StaticResource Muted}"/>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" IsVisible="{Binding MostrarSemResultados}">
                <Label Text="O IBGE não retornou nomes para esta localidade." Style="{StaticResource Muted}"/>
            </Border>
            <VerticalStackLayout IsVisible="{Binding TemNomes}" Spacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="2. Confira os resultados" FontSize="20" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2"/>
                    <Label Text="{Binding LocalidadeDescricao}" FontSize="16" FontAttributes="Bold"/>
                    <Label Text="Do mais frequente ao menos frequente. Role para ver as listas completas." Style="{StaticResource Muted}"/>
                </VerticalStackLayout>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Homens" FontSize="19" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding NomesHomens.Count, StringFormat='{0} nomes'}" Style="{StaticResource Muted}" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label Text="Nome" Style="{StaticResource Muted}"/>
                            <Label Grid.Column="1" Text="Pessoas" Style="{StaticResource Muted}"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DDE3EC, Dark=#344054}"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding NomesHomens}" BindableLayout.ItemTemplate="{StaticResource NameRow}"/>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Mulheres" FontSize="19" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding NomesMulheres.Count, StringFormat='{0} nomes'}" Style="{StaticResource Muted}" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label Text="Nome" Style="{StaticResource Muted}"/>
                            <Label Grid.Column="1" Text="Pessoas" Style="{StaticResource Muted}"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DDE3EC, Dark=#344054}"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding NomesMulheres}" BindableLayout.ItemTemplate="{StaticResource NameRow}"/>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}" IsVisible="{Binding TemSobrenomes}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Sobrenomes" FontSize="19" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="{Binding Sobrenomes.Count, StringFormat='{0} nomes'}" Style="{StaticResource Muted}" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label Text="Nome" Style="{StaticResource Muted}"/>
                            <Label Grid.Column="1" Text="Pessoas" Style="{StaticResource Muted}"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#DDE3EC, Dark=#344054}"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sobrenomes}" BindableLayout.ItemTemplate="{StaticResource NameRow}"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <Label Text="Fonte: IBGE · Censo 2022. Consulta online por localidade." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,4,0,12"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
